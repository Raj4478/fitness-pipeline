# ── LLM — pick your provider ──────────────────────────────────────────
# Recommended order: gemini (free) → groq (nearly free) → deepseek (paid)
LLM_PROVIDER=gemini

# Gemini (primary — free tier, 15 req/min)
# Get key: aistudio.google.com → "Get API key"
# Valid models: gemini-2.5-flash-lite | gemini-2.5-flash | gemini-2.0-flash
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# Groq (optional fallback — $0.05/1M tokens, very generous free tier)
# Get key: console.groq.com → "Create API key"
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.1-8b-instant

# DeepSeek (optional — requires paid credits, skip if not using)
# Add credits at: platform.deepseek.com → Billing
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ── ElevenLabs ────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# ── Creatomate ────────────────────────────────────────────────────────
CREATOMATE_API_KEY=your_creatomate_key_here
CREATOMATE_TEMPLATE_ID=your_template_uuid_here

# ── Buffer ────────────────────────────────────────────────────────────
BUFFER_ACCESS_TOKEN=your_buffer_token_here
BUFFER_CHANNELS=channel_id_1,channel_id_2

# ── Pexels ────────────────────────────────────────────────────────────
PEXELS_API_KEY=your_pexels_key_here

# ── GitHub Releases (video/audio storage — free, replaces Cloudinary) ──
# Create token at github.com/settings/tokens → Fine-grained → repo scope
# Add as GitHub Secret: GH_UPLOAD_TOKEN
GH_UPLOAD_TOKEN=your_github_pat_with_repo_scope

# ── App ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── GitHub Actions Token (for bot to trigger workflows) ──────────────
# Go to github.com → Settings → Developer Settings → 
# Personal Access Tokens → Fine-grained token
# Permissions needed: Actions (Read & Write)
GH_ACTIONS_TOKEN=your_github_pat_here

# ── Telegram Bot ──────────────────────────────────────────────────────
# Get token from @BotFather on Telegram → /newbot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Get your user ID from @userinfobot on Telegram → /getid  
TELEGRAM_ALLOWED_USER_ID=your_telegram_user_id_here

# ── Repo/branch overrides (optional) ────────────────────────────────────
GITHUB_REPO=owner/repo
GITHUB_DEFAULT_BRANCH=main
