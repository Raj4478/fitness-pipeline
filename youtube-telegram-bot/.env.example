# Existing fitness-pipeline GitHub secrets can be reused under these same names.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# Recommended for webhook authentication. Optional in code if left unset.
TELEGRAM_WEBHOOK_SECRET=
WEBHOOK_URL=

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Reuse the existing YouTube OAuth credentials from fitness-pipeline.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Optional alternative. Not required when the OAuth credentials above are configured.
YOUTUBE_API_KEY=

ACCOUNT_NICHE=chiropractic education, posture, mobility and spine health
ACCOUNT_TONE=educational, curious, concise, social-first and non-diagnostic
HASHTAG_COUNT=18

# Comma-separated HTTPS hosts that you control / have permission to relay media from.
# Example: cdn.example.com,storage.example.com
DOWNLOAD_ALLOWLIST_HOSTS=
